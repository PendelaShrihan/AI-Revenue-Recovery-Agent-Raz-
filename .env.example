# ==========================================
# Razorpay AI Revenue Recovery Agent - Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
APP_SECRET_KEY=dev-secret-key-change-in-production

# Razorpay API Credentials (Sandbox / Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Provider Configuration (Choose 'anthropic', 'openai', 'gemini', or 'mock')
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
OLLAMA_BASE_URL=http://localhost:11434

# Database Configuration (SQLite default / PostgreSQL optional)
DATABASE_URL=sqlite:///./data/recovery_agent.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./data/recovery_agent.db
# For PostgreSQL: postgresql://user:password@localhost:5432/razorpay_recovery

# Revenue Recovery Engine Guardrails
MAX_RETRY_ATTEMPTS=2
RETRY_BASE_BACKOFF_MINUTES=5
SIMULATION_MODE=True
